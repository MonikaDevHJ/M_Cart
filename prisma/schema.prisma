generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id String @id @default(uuid())

  // Seller Details
  companyName  String
  email        String
  phone        String
  businessName String
  gstNumber    String
  location     String
  sellerDesc   String

  // Product Details
  productName    String
  productSize    String
  selectCategory String
  stockQuantity  Int
  brandName      String
  selectSize     String
  productImage   String?

  created_at DateTime @default(now())
}
